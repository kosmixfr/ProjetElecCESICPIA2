int main()
{
 
  Wire.setWireTimeout(CAPTEUR_TIMEOUT);
  Wire.begin();
  Serial.begin(9600);
  gpsSerial.begin(9600);
  if (!capteur.begin(0x76))
  {
    if (!capteur.begin(0x77))
    {
      Serial.println("Erreur : BME280 introuvable !");
      OnImprimeLerreurViaLed(3);
      delay(100 ^ 100);
    }
  }
  if (!SD.begin(SD_CS))
  {
    OnImprimeLerreurViaLed(5);
    return;
  }
}
 
Parameters *GetParam(char *name)
{
  for (int i = 0; i < sizeof(losParametros) / sizeof(Parameters); i++)
  {
    if (strcmp(name, losParametros[i].Name) == 0)
    {
      return &losParametros[i];
    }
  }
  printf("Paramétros non trouvé gringo ! ");
}
 
// 1=error,0=continue
int ValidCapteurData(char *name, int value)
{
  int minVal;
  int maxVal;
  if (strcmp(name, "TEMP_AIR") == 0)
  {
    minVal = GetParam("MIN_TEMP_AIR")->Value;
    maxVal = GetParam("MAX_TEMP_AIR")->Value;
  }
  if (strcmp(name, "HYGR") == 0)
  {
    minVal = GetParam("HYGR_MINT")->Value;
    maxVal = GetParam("HYGR_MAXT")->Value;
  }
  if (strcmp(name, "PRESSURE") == 0)
  {
    minVal = GetParam("PRESSURE_MIN")->Value;
    maxVal = GetParam("PRESSURE_MAX")->Value;
  }
  if (minVal < value || maxVal > value)
  {
    OnImprimeLerreurViaLed(4);
    return 1;
  }
  return 0;
}
 
struct Record *batch[100];
int SavedBatch = 0;
 
// 1=error,0=success;
int AppendSdCard(Record *record, DateTime *date)
{
  if (SavedBatch == 100)
  {
    File *fichier = GetFile(date);
    if (fichier == NULL)
    {
      return 1;
    }
    for (int i = 0; i < SavedBatch; i++)
    {
      char buffer[150];
      snprintf(buffer, sizeof(buffer),
               "%.6f;%.6f;%.2f;%.2f;%.2f\n",
               (*batch[i]).Latitude,
               (*batch[i]).Longitude,
               (*batch[i]).Temperature,
               (*batch[i]).Humidity,
               (*batch[i]).Pressure);
      size_t written = fichier->write(buffer);
      if (written != sizeof(buffer))
      {
        OnImprimeLerreurViaLed(6);
      }
    }
    fichier->close();
    SavedBatch = 0;
  }
  else
  {
    batch[SavedBatch] = record;
    SavedBatch++;
  }
}
 
File *GetFile(DateTime *date)
{
  int max_size = GetParam("FILE_MAX_SIZE")->Value;
  char nomFichier[20];
  int i = 0;
  while (true)
  {
    sprintf(nomFichier, "%02d%02d%02d_%d.LOG",
            date->year(), date->month(), date->day(), i);
    File file = SD.open(nomFichier, FILE_WRITE);
    if (file == NULL)
    {
      OnImprimeLerreurViaLed(5);
      return NULL;
    }
    if (file.size() < max_size)
    {
      return &file;
    }
    file.close();
    i++;
  }
}
 
void PrintRecord(Record *record)
{
  Serial.println();
  Serial.println(F("+--------------------------------------+"));
  Serial.println(F("|         RELEVE DES CAPTEURS          |"));
  Serial.println(F("+--------------------------------------+"));
 
  if (record == NULL)
  {
    Serial.println(F("| Aucun enregistrement disponible      |"));
    Serial.println(F("+--------------------------------------+"));
    Serial.println();
    return;
  }
 
  char date[20];
  if (record->DateTime != NULL)
  {
    strftime(date, sizeof(date), "%d/%m/%Y %H:%M:%S", record->DateTime);
  }
  else
  {
    strcpy(date, "--/--/---- --:--:--");
  }
 
  char latitude[16];
  char longitude[16];
  char temperature[16];
  char humidite[16];
  char pression[16];
 
  dtostrf(record->Latitude, 0, 5, latitude);
  dtostrf(record->Longitude, 0, 5, longitude);
 
  dtostrf(record->Temperature, 0, 2, temperature);
  strcat(temperature, " C");
 
  dtostrf(record->Humidity, 0, 2, humidite);
  strcat(humidite, " %");
 
  dtostrf(record->Pressure, 0, 2, pression);
  strcat(pression, " hPa");
 
  char ligne[64];
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Date", date);
  Serial.println(ligne);
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Latitude", latitude);
  Serial.println(ligne);
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Longitude", longitude);
  Serial.println(ligne);
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Temperature", temperature);
  Serial.println(ligne);
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Humidite", humidite);
  Serial.println(ligne);
  snprintf(ligne, sizeof(ligne), "| %-12s : %-19s |", "Pression", pression);
  Serial.println(ligne);
 
  Serial.println(F("+--------------------------------------+"));
  Serial.println();
}
 
void ModeMaintenance()
{
  while (1)
  {
    Record *record = GetNewRecord(true);
    PrintRecord(record);
    free(record);
    delay(1000);
  }
}
Record *GetNewRecord(int withGps)
{
  int timeout = GetParam("TIMEOUT")->Value;
  int start = millis();
  int temperature = capteur.readTemperature();
  int pression = capteur.readPressure();
  int humidity = capteur.readHumidity();
  double lattitude = 0;
  double longitude = 0;
  if (withGps)
  {
    while (gpsSerial.available())
    {
      gps.encode(gpsSerial.read());
    }
    lattitude = gps.location.lat();
    longitude = gps.location.lng();
  }
  // utilisation impossible au 0,0 du globe
  if (lattitude == 0 || longitude == 0)
  {
    OnImprimeLerreurViaLed(2);
    return NULL;
  }
  int end = millis();
  if ((isnan(temperature) || isnan(pression) || isnan(humidity)) || (end - start) > timeout)
  {
    SumCapteurError++;
  }
  if (SumCapteurError >= 2)
  {
    OnImprimeLerreurViaLed(3);
    return;
  }
  if ((ValidCapteurData("TEMP_AIR", temperature) + ValidCapteurData("HYGR", humidity) + ValidCapteurData("PRESSURE", pression)) > 0)
  {
    return;
  }
  Record *record_ptr = (Record *)malloc(sizeof(Record));
 
  return record_ptr;
}
 
void ModeNormalOrEco(bool ecoMode)
{
  int shouldDoGPS = true;
 
  while (1)
  {
    Record *record_ptr = GetNewRecord(shouldDoGPS);
    if (AppendSdCard(record_ptr, NULL) > 0)
    {
      return;
    }
    free(record_ptr);
    delay(GetParam("LOG_INTERVAL")->Value * 1000 * (ecoMode + 1));
    if (ecoMode == 1)
    {
      shouldDoGPS = !shouldDoGPS;
    }
  }
}
void ModeConfig()
{
  Serial.println("=== Mode configuration ===");
  Serial.print("Imprimer la commande :");
  char commande[40];
  int currentCommandeIndex = 0;
  char valeur[40];
  int currentValeurIndex = 0;
  int haveEqual = false;
  while (Serial.available())
  {
    char caractere = Serial.read();
 
    if (caractere == '\r' || caractere == '\n')
    {
      Serial.println(ProcessCommande(commande, valeur));
      currentCommandeIndex = 0;
      currentValeurIndex = 0;
      haveEqual = false;
      continue;
    }
    
    
    if (caractere == '=')
    {
      haveEqual = true;
    }
    
    
    else
    {
      if (haveEqual)
      {
        valeur[currentValeurIndex] = caractere;
        currentValeurIndex++;
      }
      else
      {
        commande[currentCommandeIndex] = caractere;
        currentCommandeIndex++;
      }
    }
  }
}
 
char *ProcessCommande(char commande[], char value[])
{
  Parameters *param = GetParam(commande);
  if (param == NULL)
  {
    return "Commande inconnu";
  }
  char *fin;
  int nombre = (int) strtol(value, &fin, 10);
  if (fin == value || *fin != '\0')
  {
    return "Nombre invalide";
  }
  if(nombre < param->MinValue || nombre > param->MaxValue){
    return "Valeur out of bound !!";
  }
  param->Value = nombre;
}
 
 
